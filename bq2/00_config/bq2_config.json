      "role": "entry_confirmation",
      "input_timeframes": [
        "M1",
        "M5",
        "M15"
      ]
    },
    "api_rule": "Quality predicts; Candle Book confirms. Low Quality probability + Book confirmation means small lot unless BLOCK/HIGH_RISK."
